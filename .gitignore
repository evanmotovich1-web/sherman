.DS_Store
*.swp
*~
node_modules/
graphify-out/
.hermes/
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/teamlore/
!.claude/skills/teamlore/**
.env
.env.*
*.local

# Private per-user memory is runtime state for THIS machine's user. The repo
# is public: a person's private memory must be impossible to commit here.
vault/memory/private/*
!vault/memory/private/.keep

# teamlore's per-session capture sentinel is runtime state.
.claude/skills/teamlore/.needs-distill

# The self-direction loop's audit log is THIS machine's run history, not
# company knowledge — each machine grows its own.
vault/direction/log.md
