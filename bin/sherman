#!/usr/bin/env bash
#
# sherman — launch Sherman Abrams, the company agent.
#
# Sherman is not its own engine. It is a branded, memory-wired layer over
# whichever coding CLI you already have. This script runs the one-time wizard if
# needed, assembles the engine adapter fresh from the repo, and hands off.
#
# The handoffs and subcommands:
#
#   sherman           the Sherman Shell — our UI, engine headless underneath
#   sherman --raw     exec the engine directly, its own chrome, for debugging
#   sherman update    fast-forward this checkout from its remote
#   sherman sync      pull + publish the shared vault (wiki, shared memory, inbox)
#   sherman model     choose a provider/model; Codex changes verify by read-back
#   sherman telegram  the Telegram bridge, same adapter and engine layer as the shell
#   sherman brief     one headless morning-brief turn; delivers to Telegram when paired
#   sherman pet       the floating desktop companion (macOS); pet stop ends it
#
# Target shell: macOS system bash 3.2. No ${var,,}, no associative arrays,
# no readlink -f.

set -euo pipefail

# ---------------------------------------------------------------- repo root --
# $0 is usually a symlink on PATH, so chase the chain by hand. `readlink -f`
# does not exist on BSD/macOS.
resolve_root() {
    src="$0"
    while [ -L "$src" ]; do
        dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")/.." && pwd
}

ROOT=$(resolve_root)

# All state hangs off $HOME, read live every time. Never hardcode a home
# directory: smoke.sh overrides HOME to sandbox its run, and a hardcoded path
# would both defeat the test and scribble on the real config.
SHERMAN_HOME="${HOME}/.sherman"
CONFIG="${SHERMAN_HOME}/config.json"
WORKSPACE="${SHERMAN_HOME}/workspace"

# ------------------------------------------------------- self-owned runtime --
# install.sh may have provisioned Node -- and npm-global tools like the codex
# CLI -- into ~/.sherman/runtime, linked into a bin directory that no shell
# startup file is guaranteed to put on PATH. Seen on the first real WSL
# machine: a broken ~/.profile kept every PATH line from ever applying, and
# the shell then claimed Node was missing while sitting next to the Node
# that installed it. The launcher finds its own runtime rather than trusting
# the shell that started it.
for runtime_bin in "$SHERMAN_HOME"/runtime/node-*/bin; do
    if [ -x "$runtime_bin/node" ]; then
        case ":$PATH:" in
            *":$runtime_bin:"*) ;;
            *) PATH="$runtime_bin:$PATH"; export PATH ;;
        esac
    fi
done

# ------------------------------------------------------------ launch screen --
launch_screen() {
    if [ -f "$ROOT/logo/banner.ans" ]; then
        cat "$ROOT/logo/banner.ans"
    else
        cat <<'PLACEHOLDER'

   SHERMAN ABRAMS
   Sherman Abrams Labs — company agent

PLACEHOLDER
    fi
}

# ------------------------------------------------------------------ engines --
# The provider registry. One line per provider:
#
#     id|label|binary|status|reason
#
# The wizard's menu renders FROM this list, so adding a provider later — or
# flipping one to available the day its backend is real — is one line here,
# never new wizard flow. An unavailable provider is listed with its reason and
# refuses selection: a selectable option that errors after selection is the
# one dishonest shape the menu is not allowed to have.
#
# bash 3.2: plain string + line tools, no associative arrays. No `|` inside
# any field.
PROVIDERS='codex|OpenAI (Codex)|codex|available|
zai|Z.AI (GLM-5.2)|opencode|available|
claude|Anthropic (Claude Code)|claude|unavailable|the Claude Code backend is not wired into the Sherman Shell yet; Codex and Z.AI GLM are the working backends today'

provider_count() {
    printf '%s\n' "$PROVIDERS" | grep -c .
}

# $1 = 1-based registry line, $2 = field number (1 id, 2 label, 3 binary,
# 4 status, 5 reason).
provider_field() {
    printf '%s\n' "$PROVIDERS" | sed -n "${1}p" | cut -d'|' -f"$2"
}

engine_binary() {
    printf '%s\n' "$PROVIDERS" \
        | awk -F'|' -v id="$1" '$1 == id { print $3; found = 1 } END { if (!found) print "unknown-engine" }'
}

engine_install_hint() {
    case "$1" in
        claude)
            echo "Claude Code is not installed. Install it with:"
            echo
            echo "    curl -fsSL https://claude.ai/install.sh | bash"
            echo
            echo "  (or: npm install -g @anthropic-ai/claude-code)"
            ;;
        codex)
            echo "Codex is not installed. Install it with:"
            echo
            echo "    npm install -g @openai/codex"
            ;;
        zai)
            echo "OpenCode is not installed. Z.AI GLM uses OpenCode as its agent runtime. Install it with:"
            echo
            echo "    npm install -g opencode-ai"
            ;;
    esac
}

# Seen on the first real Windows machine: with WSL's PATH interop on,
# `codex` inside Ubuntu resolved to the WINDOWS npm's shim under /mnt/c/...,
# which dies on its first import with "Missing optional dependency
# @openai/codex-linux-x64" -- the package behind it is the Windows build.
# That shim is not an install, it is a trap, and install.sh now refuses to
# count it. This guard heals machines installed before that: if the codex
# on PATH lives under /mnt, install the Linux one right here with the
# runtime's own npm (already prepended to PATH above) and verify it runs.
ensure_linux_codex() {
    found=$(command -v codex 2>/dev/null || true)
    case "$found" in
        /mnt/*) ;;
        *) return 0 ;;  # absent or already a Linux codex: nothing to heal
    esac
    echo "  the codex on PATH is Windows' own install ($found)"
    echo "  and cannot run inside Ubuntu. Installing the Linux codex CLI"
    echo "  (npm install -g @openai/codex) ..."
    npm_bin=$(command -v npm 2>/dev/null || true)
    case "$npm_bin" in /mnt/*) npm_bin="" ;; esac
    if [ -z "$npm_bin" ]; then
        echo "  ...but there is no Linux npm to install it with."
        echo "  Run ./install.sh in the sherman repo, then sherman again."
        return 1
    fi
    "$npm_bin" install -g @openai/codex >/dev/null 2>&1 || true
    hash -r 2>/dev/null || true
    found=$(command -v codex 2>/dev/null || true)
    case "$found" in
        /mnt/*|'')
            echo "  ...npm ran but no Linux codex appeared on PATH."
            echo "  Install it by hand:  npm install -g @openai/codex"
            return 1 ;;
    esac
    if codex --version >/dev/null 2>&1; then
        echo "  ...codex $(codex --version 2>/dev/null) installed at $found (verified: codex --version)"
        return 0
    fi
    echo "  ...a codex appeared at $found but did not run. Install it by hand:"
    echo "     npm install -g @openai/codex"
    return 1
}

# Z.AI's supported coding-agent path is OpenCode. Heal a missing or WSL-host
# shim on demand and claim success only after the installed CLI exposes every
# run flag Sherman's transport requires.
opencode_is_compatible() {
    opencode --version >/dev/null 2>&1 || return 1
    # OpenCode writes help to stderr, so capture both streams for capability
    # detection instead of treating a healthy install as stale every launch.
    opencode_help=$(opencode run --help 2>&1) || return 1
    case "$opencode_help" in *--pure*) ;; *) return 1 ;; esac
    case "$opencode_help" in *--format*) ;; *) return 1 ;; esac
    case "$opencode_help" in *--session*) ;; *) return 1 ;; esac
    case "$opencode_help" in *--agent*) ;; *) return 1 ;; esac
    auth_help=$(opencode auth login --help 2>&1) || return 1
    case "$auth_help" in *--provider*) ;; *) return 1 ;; esac
    case "$auth_help" in *--pure*) ;; *) return 1 ;; esac
    return 0
}

ensure_opencode() {
    found=$(command -v opencode 2>/dev/null || true)
    case "$found" in
        /mnt/*|'') ;;
        *) opencode_is_compatible && return 0 ;;
    esac
    npm_bin=$(command -v npm 2>/dev/null || true)
    case "$npm_bin" in /mnt/*) npm_bin="" ;; esac
    if [ -z "$npm_bin" ]; then
        engine_install_hint zai
        return 1
    fi
    echo "  installing OpenCode for Z.AI GLM (npm install -g opencode-ai) ..."
    "$npm_bin" install -g opencode-ai >/dev/null 2>&1 || true
    hash -r 2>/dev/null || true
    found=$(command -v opencode 2>/dev/null || true)
    case "$found" in /mnt/*|'') found="" ;; esac
    if [ -n "$found" ] && opencode_is_compatible; then
        echo "  ...OpenCode $(opencode --version 2>/dev/null) installed at $found (verified: required run flags present)"
        return 0
    fi
    echo "  OpenCode did not install successfully. Run: npm install -g opencode-ai" >&2
    return 1
}

has_zai_auth() {
    # Coding Plan is a different OpenCode provider/model namespace. This engine
    # is deliberately the standard Z.AI API path, so do not accept a Coding
    # Plan-only credential and then fail later at model resolution.
    opencode auth list 2>/dev/null \
        | grep -Ei 'Z\.AI|zai' \
        | grep -Eiv 'Coding Plan|coding-plan' \
        | grep -q .
}

ensure_zai_auth() {
    has_zai_auth && return 0
    if [ -t 0 ]; then
        echo
        echo "Z.AI GLM needs your Z.AI key — from either the API or the Coding Plan."
        echo "Paste it in the prompt below (not an OpenRouter key); you will say which"
        echo "product it belongs to next, so Sherman aims it at the right endpoint."
        echo "OpenCode is only the local coding runtime; Sherman is opening its Z.AI-only key prompt."
        opencode auth login --pure --provider zai || return 1
        has_zai_auth && return 0
    fi
    echo "Z.AI is not signed in. Run: opencode auth login --pure --provider zai" >&2
    echo "Paste your Z.AI key there, then run sherman again." >&2
    return 1
}

# Which Z.AI product the key belongs to. ASKED, never probed: the launcher
# deliberately never touches the key's bytes, and only the operator knows
# what they bought. The answer matters because the two products refuse each
# other's doors — a Coding Plan key on the general API dies as error 1113,
# which OpenCode retries silently (seen live as an endless "initializing
# agent"). Non-interactive runs keep whatever the config already says; the
# shell defaults an absent field to the standard API, the only behavior that
# existed before this field.
ask_zai_plan() {
    [ -t 0 ] || return 0
    echo
    echo "Which Z.AI product is your key from?"
    echo "  [1] Z.AI API (pay-as-you-go credit)"
    echo "  [2] Z.AI Coding Plan (the GLM subscription)"
    printf "Choose a number > "
    read -r zai_plan_pick
    if [ "$zai_plan_pick" = "2" ]; then
        config_set zai_plan coding
        echo "  plan: Coding Plan — Sherman will use the coding endpoint"
    else
        config_set zai_plan api
    fi
}

require_engine() {
    bin=$(engine_binary "$1")
    if [ "$bin" = "codex" ]; then
        ensure_linux_codex || exit 1
    elif [ "$bin" = "opencode" ]; then
        ensure_opencode || exit 1
    fi
    if ! command -v "$bin" >/dev/null 2>&1; then
        echo >&2
        engine_install_hint "$1" >&2
        echo >&2
        echo "Then run sherman again." >&2
        exit 1
    fi
}

# --------------------------------------------------------------------- node --
# The shell is a Node app. If Node is missing or too old we say so and stop --
# we do NOT quietly exec the engine instead. A silent fallback would drop you
# into the engine's own chrome while you believed you were in Sherman, which is
# the exact problem the shell exists to solve. --raw stays available; choosing
# it should be your decision, not a surprise.
require_node() {
    if ! command -v node >/dev/null 2>&1; then
        echo >&2
        echo "The Sherman Shell needs Node.js 22 or newer, and node is not on your PATH." >&2
        echo >&2
        echo "Install Node 22+, then run sherman again." >&2
        echo >&2
        echo "To keep working without the shell in the meantime:" >&2
        echo >&2
        echo "    sherman --raw" >&2
        echo >&2
        exit 1
    fi

    # `node --version` prints like "v22.23.1". Strip the v, take the major.
    # Cut and sed, not bash arithmetic on a string -- bash 3.2 would happily
    # evaluate "v22" as 0 and silently pass a version check.
    node_version=$(node --version 2>/dev/null)
    node_major=$(printf '%s' "$node_version" | sed 's/^v//' | cut -d. -f1)

    case "$node_major" in
        ''|*[!0-9]*)
            echo >&2
            echo "Could not read a Node.js version from: $node_version" >&2
            echo "The Sherman Shell needs Node 22 or newer. Try: sherman --raw" >&2
            echo >&2
            exit 1
            ;;
    esac

    if [ "$node_major" -lt 22 ]; then
        echo >&2
        echo "The Sherman Shell needs Node.js 22 or newer. Found $node_version." >&2
        echo >&2
        echo "Upgrade Node, then run sherman again." >&2
        echo >&2
        echo "To keep working without the shell in the meantime:" >&2
        echo >&2
        echo "    sherman --raw" >&2
        echo >&2
        exit 1
    fi

    if [ ! -d "$ROOT/shell/node_modules" ]; then
        echo >&2
        echo "The Sherman Shell's dependencies are not installed." >&2
        echo >&2
        echo "Run:" >&2
        echo >&2
        echo "    $ROOT/install.sh" >&2
        echo >&2
        echo "Or work without the shell for now:" >&2
        echo >&2
        echo "    sherman --raw" >&2
        echo >&2
        exit 1
    fi
}

# A compact stand-in for the banner. Used only when the wizard runs on the way
# into the shell: the shell draws the full mark itself, and printing it here too
# would show it twice on a first run.
wizard_header() {
    echo
    echo "  SHERMAN ABRAMS"
    echo "  Sherman Abrams Labs — company agent"
}

# ------------------------------------------------------------------- wizard --
slugify() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr ' ' '-' \
        | tr -cd 'a-z0-9_-'
}

run_wizard() {
    echo
    echo "Setting up Sherman on this machine."
    echo

    # 1. Provider. This IS the engine choice. Sherman performs no OAuth of its
    #    own -- the engine's native browser login fires on first launch if it
    #    is not already authenticated.
    #
    #    The menu renders from the provider registry. Unavailable providers are
    #    shown -- silence would read as "does not exist" -- but refuse
    #    selection with their reason and re-prompt.
    echo "Sign in with:"
    total=$(provider_count)
    i=1
    while [ "$i" -le "$total" ]; do
        if [ "$(provider_field "$i" 4)" = "available" ]; then
            echo "  [$i] $(provider_field "$i" 2)"
        else
            echo "  [$i] $(provider_field "$i" 2) — not available yet"
        fi
        i=$((i + 1))
    done

    engine=""
    while [ -z "$engine" ]; do
        printf 'Choose a number > '
        if ! read -r reply; then
            echo >&2
            echo "No answer given. Aborting." >&2
            exit 1
        fi
        case "$reply" in
            ''|*[!0-9]*)
                echo "  Enter a number between 1 and $total."
                continue
                ;;
        esac
        if [ "$reply" -lt 1 ] || [ "$reply" -gt "$total" ]; then
            echo "  Enter a number between 1 and $total."
            continue
        fi
        if [ "$(provider_field "$reply" 4)" != "available" ]; then
            echo "  $(provider_field "$reply" 2) is not available yet — $(provider_field "$reply" 5)."
            continue
        fi
        engine=$(provider_field "$reply" 1)
    done

    # Fail before writing any config if the engine is missing.
    require_engine "$engine"

    # 2. Who you are. Becomes a directory name, so slugify it.
    user=""
    while [ -z "$user" ]; do
        printf 'Your name > '
        if ! read -r raw; then
            echo >&2
            echo "No answer given. Aborting." >&2
            exit 1
        fi
        user=$(slugify "$raw")
        [ -z "$user" ] && echo "  Need at least one letter or number."
    done

    ask_model
    ask_telegram

    vault="$ROOT/vault"

    mkdir -p "$SHERMAN_HOME"
    extra=""
    [ -n "$tg_token" ] && extra=$(printf ',"telegram_token":"%s"' "$tg_token")
    printf '{"version":2,"engine":"%s","user":"%s","vault_path":"%s"%s}\n' \
        "$engine" "$user" "$vault" "$extra" > "$CONFIG"

    # Read back what was just written, both as JSON and as the engine value.
    # A config that does not parse must die HERE, deleted, where redoing setup
    # fixes it -- not on the next launch as a parse error nobody can connect
    # to the answers they typed. A real Windows machine hit exactly that.
    if command -v /usr/bin/jq >/dev/null 2>&1 \
        && ! /usr/bin/jq empty "$CONFIG" >/dev/null 2>&1; then
        rm -f "$CONFIG"
        echo "Setup produced a config that does not parse, so it was not kept." >&2
        echo "Run sherman again to redo setup." >&2
        exit 1
    fi
    if [ "$(config_get engine)" != "$engine" ]; then
        rm -f "$CONFIG"
        echo "Setup wrote a config that did not read back, so it was not kept." >&2
        echo "Run sherman again to redo setup." >&2
        exit 1
    fi

    echo
    echo "  engine: $engine"
    echo "  user:   $user"
    echo "  vault:  $vault"
    if [ -n "$tg_token" ]; then
        echo "  telegram: token saved -- after setup, run: sherman telegram"
        echo "            (first message to the bot prints the chat id to pair)"
    fi
    echo
    echo "Starting your session."
    echo
}

# Codex owns the model choice: the shell reads it back from codex's own
# config and never forces -m, so the one honest place to record a
# preference is that config. Top-level key only; the file is backed up
# before any edit and every claim follows a read-back.
codex_config_path() { printf '%s' "${CODEX_HOME:-$HOME/.codex}/config.toml"; }

read_codex_model() {
    cfg=$(codex_config_path)
    [ -f "$cfg" ] || return 0
    sed -n '/^\[/q; s/^[[:space:]]*model[[:space:]]*=[[:space:]]*"\{0,1\}\([^"#]*\)"\{0,1\}[[:space:]]*$/\1/p' "$cfg" | head -1
}

# Refuses input that cannot be a model name. Learned on the first real
# Windows machine, where a stray keystroke became model = "k" in codex's
# config and would have failed every turn: a single character or anything
# without a digit is a typo, not a model, and writing it is worse than
# asking again.
write_codex_model() {
    new_model="$1"
    cfg=$(codex_config_path)
    case "$new_model" in
        ''|*[!A-Za-z0-9._-]*)
            echo "  '$new_model' does not look like a model name; nothing was changed."
            return 1 ;;
    esac
    case "$new_model" in
        *[0-9]*) ;;
        *)
            echo "  '$new_model' does not look like a model name (no digit); nothing was changed."
            return 1 ;;
    esac
    if [ "${#new_model}" -lt 2 ]; then
        echo "  '$new_model' does not look like a model name; nothing was changed."
        return 1
    fi
    current_model=$(read_codex_model)
    mkdir -p "$(dirname "$cfg")"
    if [ -f "$cfg" ]; then
        cp "$cfg" "$cfg.sherman-backup"
        if [ -n "$current_model" ]; then
            # Replace the top-level line only; section keys are that
            # section's business, exactly as the shell reads it.
            awk -v m="$new_model" '
                /^\[/ { insec = 1 }
                !insec && /^[[:space:]]*model[[:space:]]*=/ && !done {
                    print "model = \"" m "\""; done = 1; next
                }
                { print }' "$cfg" > "$cfg.sherman-tmp" \
                && mv "$cfg.sherman-tmp" "$cfg"
        else
            { printf 'model = "%s"\n' "$new_model"; cat "$cfg.sherman-backup"; } > "$cfg"
        fi
    else
        printf 'model = "%s"\n' "$new_model" > "$cfg"
    fi
    written=$(read_codex_model)
    if [ "$written" = "$new_model" ]; then
        echo "  model $new_model set (verified: read back from codex's own config)"
        return 0
    fi
    echo "  could not verify the model landed in $cfg -- codex's default stays in effect."
    return 1
}

# Model question (codex only). Reads $engine.
ask_model() {
    if [ "$engine" = "codex" ]; then
        current_model=$(read_codex_model)
        echo
        if [ -n "$current_model" ]; then
            printf 'Codex model [current: %s] — Enter keeps it, or type another > ' "$current_model"
        else
            printf 'Codex model — Enter keeps the codex default, or type one (e.g. gpt-5.6-sol) > '
        fi
        read -r model_reply || model_reply=""
        model_reply=$(printf '%s' "$model_reply" | tr -d '"' | tr -d ' ')
        if [ -n "$model_reply" ]; then
            write_codex_model "$model_reply" || true
        fi
    fi
}

# Telegram question (optional). The connect flow is offered because the
# bridge exists (bridge/telegram.js) -- DESIGN.md's rule, honored in that
# order. Enter skips; nothing is ever required here. Guided step-by-step
# because "paste a token" assumes the person already knows BotFather:
# spelled-out taps, a suggested name, and one string to copy. Telegram has
# no email+password login and only BotFather mints bots, so a token IS the
# minimal honest secret -- Sherman never asks for anyone's Telegram account
# login. WhatsApp is named as not built because silence would read as
# "does not exist". Reads $user for the suggested bot name; sets $tg_token.
ask_telegram() {
    tg_token=""
    bot_slug=$(printf '%s' "${user:-sherman}" | tr '-' '_')
    echo
    echo "Use Sherman from your phone via Telegram (optional -- Enter skips):"
    echo
    echo "  1. Open Telegram and go to:  https://t.me/BotFather"
    echo "  2. Send:      /newbot"
    echo "  3. Name it:   ${user:-your name}'s Sherman"
    echo "  4. Username:  ${bot_slug}_sherman_bot     (Telegram requires the 'bot' ending)"
    echo "  5. BotFather replies with a token -- copy it and paste it here."
    echo
    echo "That token is the only secret involved. Sherman never asks for your"
    echo "Telegram account login -- no email, no password, no phone number."
    echo "(WhatsApp is not built yet; Telegram is the phone channel today.)"
    printf 'Telegram bot token > '
    read -r tg_token || tg_token=""
    tg_token=$(printf '%s' "$tg_token" | tr -d ' "')
    if [ -n "$tg_token" ]; then
        echo "  After setup, run: sherman telegram -- it shows a pairing code;"
        echo "  text that code to your bot and the chat pairs itself."
    fi
}

# One-time catch-up for a machine set up before newer questions existed:
# config versions below 2 get asked exactly the questions they never saw,
# then the version is bumped so this never repeats. Interactive terminals
# only -- a piped or scripted run is not a person who can answer.
run_setup_upgrade() {
    echo
    echo "Sherman has new setup options this machine has not answered yet."
    engine="$ENGINE"
    user="$USER_SLUG"
    ask_model
    ask_telegram
    if [ -n "$tg_token" ]; then
        config_set telegram_token "$tg_token"
        echo "  telegram: token saved -- run: sherman telegram"
        echo "            (first message to the bot prints the chat id to pair)"
    fi
    if command -v /usr/bin/jq >/dev/null 2>&1; then
        /usr/bin/jq '.version = 2' "$CONFIG" > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"
    else
        sed -i.bak 's/"version"[[:space:]]*:[[:space:]]*[0-9][0-9]*/"version":2/' "$CONFIG" && rm -f "$CONFIG.bak"
    fi
    echo
}

# ------------------------------------------------------------ config access --
# A corrupt config is REPAIRED, not diagnosed at the person: the file is
# moved aside -- never deleted, it is evidence of a writer this repo
# believes cannot exist -- and setup simply runs again. Both the launch
# flow and `sherman update` call this, so either button a person presses
# when something is wrong actually fixes it. Sets $config_quarantined so
# the caller can say what happens next in its own context.
config_quarantined=""
quarantine_corrupt_config() {
    [ -f "$CONFIG" ] || return 0
    command -v /usr/bin/jq >/dev/null 2>&1 || return 0
    /usr/bin/jq empty "$CONFIG" >/dev/null 2>&1 && return 0
    config_quarantined="$CONFIG.bad.$(date +%Y%m%d_%H%M%S)"
    mv "$CONFIG" "$config_quarantined"
    echo "The config at $CONFIG did not parse and was moved aside to:"
    echo "  $config_quarantined"
}

# Backstop for the paths that cannot re-run setup (a scheduler saving a
# token, say): refuse a corrupt config with the remedy, never a raw jq
# parse error. Under set -e, one failed jq inside $( ) kills this script
# with nothing but jq's own noise on screen -- seen on a real Windows
# machine as a bare "parse error: Invalid escape" and a Sherman that would
# not start, while the remedy below never got the chance to print. Worded
# identically to shell/src/config.js on purpose: two different repair
# instructions for one problem is how a person ends up trusting neither.
require_parseable_config() {
    [ -f "$CONFIG" ] || return 0
    command -v /usr/bin/jq >/dev/null 2>&1 || return 0
    /usr/bin/jq empty "$CONFIG" >/dev/null 2>&1 && return 0
    echo "Config at $CONFIG is not valid JSON. Delete it and run sherman again." >&2
    exit 1
}

config_get() {
    require_parseable_config
    if command -v /usr/bin/jq >/dev/null 2>&1; then
        /usr/bin/jq -r --arg k "$1" '.[$k] // empty' "$CONFIG"
    else
        # Fallback for a machine without jq. Values here are engine names,
        # slugs and paths -- no embedded quotes to worry about.
        sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$CONFIG"
    fi
}

# Set one string key in the config, verified by reading it back. The config is
# this script's own single-line JSON, which is what keeps the no-jq fallback
# honest: it edits a shape this script wrote.
config_set() {
    if [ ! -f "$CONFIG" ]; then
        echo "No config yet. Run sherman once to set up this machine, then retry." >&2
        exit 1
    fi
    require_parseable_config
    if command -v /usr/bin/jq >/dev/null 2>&1; then
        /usr/bin/jq --arg k "$1" --arg v "$2" '.[$k] = $v' "$CONFIG" > "$CONFIG.tmp" \
            && mv "$CONFIG.tmp" "$CONFIG"
    else
        if grep -q "\"$1\"" "$CONFIG"; then
            sed -i.bak "s/\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"$1\":\"$2\"/" "$CONFIG" && rm -f "$CONFIG.bak"
        else
            sed -i.bak "s/}\$/,\"$1\":\"$2\"}/" "$CONFIG" && rm -f "$CONFIG.bak"
        fi
    fi
    if [ "$(config_get "$1")" != "$2" ]; then
        echo "Could not write $1 to $CONFIG." >&2
        exit 1
    fi
}

# ------------------------------------------------------------------- update --
shell_version() {
    # package.json's formatting is machine-stable; sed keeps this path working
    # on a machine with no jq at all.
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$ROOT/shell/package.json" 2>/dev/null | head -1
}

# `sherman update` pulls this checkout forward, and says so honestly when it
# cannot: no remote means no update source, and a diverged tree is a person's
# merge to make, never this script's. It must work with no engine installed
# and no config written, which is why it dispatches before everything else.
run_update() {
    if ! command -v git >/dev/null 2>&1 \
        || ! git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
        echo "This install is not a git checkout, so it cannot self-update."
        echo "Updates come from the installer: $ROOT/install.sh"
        exit 0
    fi

    if [ -z "$(git -C "$ROOT" remote 2>/dev/null)" ]; then
        echo "Sherman Abrams v$(shell_version) — no update source configured."
        exit 0
    fi

    # One press does everything: pull first, then hand the rest of the update
    # to the launcher the pull just delivered. Without this re-exec, the copy
    # of this script already loaded in memory keeps running its OLD logic
    # against the NEW checkout -- so a fix to the update process itself never
    # applies to the update that ships it, and the operator is told to press
    # update twice. The env var is the loop guard: the re-exec'd run skips the
    # pull (it already happened) and finishes with reconcile and verification.
    # The pre-pull version rides along so "Updated: vX -> vY" reports the real
    # transition rather than comparing the new version to itself.
    if [ -z "${SHERMAN_UPDATE_REEXEC:-}" ]; then
        old_version=$(shell_version)

        if ! git -C "$ROOT" pull --ff-only; then
            echo >&2
            echo "manual update needed — this checkout cannot fast-forward onto its remote." >&2
            exit 1
        fi

        exec env SHERMAN_UPDATE_REEXEC=1 \
            SHERMAN_UPDATE_OLD_VERSION="$old_version" \
            "$ROOT/bin/sherman" update
    fi
    old_version="${SHERMAN_UPDATE_OLD_VERSION:-$(shell_version)}"

    # Reconcile the shell's dependencies to the lockfile before verifying, with
    # `npm ci` -- a clean, exact install that wipes node_modules and rebuilds it
    # from the lock. The old code ran `npm install` only when a pull changed the
    # dependency contract; that let a tree drift from the lock (an older
    # transitive width dep that renders the composer a cell short, say) survive
    # untouched and then FAIL the very verification below -- which is why the
    # first Linux machine could never update: `sherman update` health-checked
    # against node_modules that no longer matched the code. Doing it every
    # update keeps the verified tree identical to the shipped lock, so a drifted
    # machine self-heals on the next update with no manual step. It needs a
    # lockfile to be exact against; without one (or without npm) there is
    # nothing to reconcile to, and the fixture-driven smoke check relies on that.
    if command -v npm >/dev/null 2>&1 && [ -f "$ROOT/shell/package-lock.json" ]; then
        if ! npm ci --prefix "$ROOT/shell"; then
            echo "Update downloaded, but the shell dependencies could not be reconciled." >&2
            echo "Run $ROOT/install.sh, then run sherman update again." >&2
            exit 1
        fi
    fi

    # ------------------------------------------------------------ llm wiki --
    # `sherman update` is the button people actually press when something is
    # wrong, so a broken wiki is repaired here rather than diagnosed at them.
    # Healthy costs one --help probe and prints nothing; a machine that never
    # provisioned a wiki is skipped; broken is re-provisioned, and "repaired"
    # is claimed behind the same verification install.sh claims "installed":
    # the CLI answering --help from its own venv.
    wiki_dir="$HOME/.sherman/llmwiki"
    wiki_py="$wiki_dir/.venv/bin/python"
    [ -x "$wiki_py" ] || wiki_py="$wiki_dir/.venv/Scripts/python.exe"
    if [ -f "$wiki_dir/llmwiki" ] \
        && ! { [ -x "$wiki_py" ] && "$wiki_py" "$wiki_dir/llmwiki" --help >/dev/null 2>&1; }; then
        if ! command -v python3 >/dev/null 2>&1; then
            echo "NOTE: the LLM Wiki here is broken and python3 is missing, so it was not repaired."
        else
            echo "repairing the LLM Wiki (its CLI stopped answering from its venv)"
            # `|| true` on the pull: in an `A && B` list a failing B is the
            # final command, which set -e treats as fatal -- an offline pull
            # would kill the update mid-repair.
            { [ -d "$wiki_dir/.git" ] \
                && git -C "$wiki_dir" pull --ff-only --quiet >/dev/null 2>&1; } || true
            # Trailing `|| true`: on Debian/Ubuntu/WSL without python3-venv this
            # fails outright, and under `set -e` that would abort the whole
            # update mid-repair -- before the honest NOTE below is ever reached.
            [ -x "$wiki_py" ] || python3 -m venv "$wiki_dir/.venv" >/dev/null 2>&1 || true
            wiki_py="$wiki_dir/.venv/bin/python"
            [ -x "$wiki_py" ] || wiki_py="$wiki_dir/.venv/Scripts/python.exe"
            if [ -x "$wiki_py" ]; then
                # A venv can exist without pip: Debian/Ubuntu half-creates it
                # (bin/python exists, runs) and DISABLES ensurepip system-wide,
                # so this repair can fail on both sides -- without `|| true`
                # that double failure kills the update right here, silently.
                "$wiki_py" -m pip --version >/dev/null 2>&1 \
                    || "$wiki_py" -m ensurepip --upgrade >/dev/null 2>&1 || true
                pip_out=$("$wiki_py" -m pip install \
                    -r "$wiki_dir/api/requirements.txt" \
                    -r "$wiki_dir/mcp/requirements.txt" 2>&1) \
                    || echo "NOTE: pip failed: $(printf '%s\n' "$pip_out" | tail -1)"
                if "$wiki_py" "$wiki_dir/llmwiki" --help >/dev/null 2>&1; then
                    echo "LLM Wiki repaired (verified: its CLI answers from its own venv)"
                else
                    echo "NOTE: the optional personal research LLM Wiki still does not answer." \
                         "Re-run install.sh for the full provisioning report."
                fi
            else
                echo "NOTE: could not create the optional personal research wiki's venv (is python3-venv installed?)."
            fi
        fi
    fi

    # -------------------------------------------------------- agent reach --
    # The same provisioner install.sh runs, so an existing machine GROWS the
    # capability on update rather than only new installs getting it. It is
    # silent when Agent Reach already answers, installs it when it does not,
    # and degrades to a NOTE on a machine that cannot have it.
    if [ -x "$ROOT/bin/provision-agent-reach.sh" ]; then
        "$ROOT/bin/provision-agent-reach.sh" || true
    fi

    # ------------------------------------------------------ config repair --
    # update is the button people press when something is wrong. A corrupt
    # config cannot be rebuilt here -- its answers belong to a person -- but
    # it CAN be moved out of the way so the next launch asks setup instead
    # of failing. Same quarantine the launch flow runs; kept, not deleted.
    quarantine_corrupt_config
    if [ -n "$config_quarantined" ]; then
        echo "The next sherman run asks the setup questions again."
    fi

    # smoke calls `sherman update`, and update runs smoke after a real pull.
    # The env guard is what keeps that pair from recursing forever.
    if ! SHERMAN_UPDATE_RUNNING=1 "$ROOT/smoke.sh"; then
        echo >&2
        echo "Update downloaded, but this machine did not pass verification." >&2
        echo "The failing check and its diagnostics are above; Sherman will not call this update healthy." >&2
        exit 1
    fi

    echo "Updated: v$old_version -> v$(shell_version)"
    exit 0
}

# --------------------------------------------------------------------- sync --
# `sherman sync` makes the vault the SAME vault on every machine, through the
# repo itself: pull what other machines published, publish what this one
# learned. Only the shared lanes travel -- wiki, shared memory, inbox.
# Private memory is gitignored and stays on this machine by design; this
# function's explicit path list is the second fence. It never touches code,
# and it refuses to run over someone else's staged work.
run_sync() {
    if ! command -v git >/dev/null 2>&1 \
        || ! git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
        echo "This install is not a git checkout, so the vault cannot sync."
        exit 1
    fi
    if [ -z "$(git -C "$ROOT" remote 2>/dev/null)" ]; then
        echo "No remote configured -- there is no shared vault to sync with."
        exit 1
    fi

    if ! git -C "$ROOT" diff --cached --quiet 2>/dev/null; then
        echo "Something is already staged in this checkout -- likely another"
        echo "session's work. Sync refuses to commit over it. Resolve that"
        echo "staging first, then run sherman sync again."
        exit 1
    fi

    if ! git -C "$ROOT" pull --ff-only; then
        echo >&2
        echo "manual merge needed -- this checkout cannot fast-forward onto its remote." >&2
        exit 1
    fi

    git -C "$ROOT" add -A -- vault/wiki vault/memory/shared vault/inbox 2>/dev/null

    if git -C "$ROOT" diff --cached --quiet; then
        echo "Vault is in sync: pulled the latest, nothing new to publish from here."
        exit 0
    fi

    who=""
    [ -f "$CONFIG" ] && who=$(config_get user)
    [ -n "$who" ] || who=$(whoami)
    git -C "$ROOT" commit -m "vault: sync from $who ($(date +%Y-%m-%d))" >/dev/null
    echo "Committed this machine's shared-vault changes."

    if git -C "$ROOT" push 2>/dev/null; then
        echo "Published (verified: git push succeeded). Every other machine"
        echo "gets this on its next sherman sync."
    else
        echo "Could not push -- this machine has no write access to the remote."
        echo "The commit is safe locally. Sign in to GitHub (for example:"
        echo "gh auth login), then run sherman sync again to publish."
        exit 1
    fi
    exit 0
}

# -------------------------------------------------------- adapter assembly --
# One body, generated here, spliced into whichever engine wrapper applies. The
# persona and the memory blocks exist in exactly one place each -- hand-copying
# them into two adapters is how the either-engine promise decays into
# Claude-only.
assemble_adapter() {
    engine="$1"; user="$2"; vault="$3"; session="$4"; sdate="$5"

    case "$engine" in
        claude) template="$ROOT/adapters/claude-code/CLAUDE.md"; out="$WORKSPACE/CLAUDE.md" ;;
        codex)  template="$ROOT/adapters/codex/AGENTS.md";        out="$WORKSPACE/AGENTS.md" ;;
        zai)    template="$ROOT/adapters/opencode/AGENTS.md";     out="$WORKSPACE/AGENTS.md" ;;
        *)
            echo "Unknown engine in config: $engine" >&2
            exit 1
            ;;
    esac

    if [ ! -f "$template" ]; then
        echo "Adapter template missing: $template" >&2
        exit 1
    fi
    if [ ! -f "$ROOT/agent/SYSTEM.md" ]; then
        echo "Persona missing: $ROOT/agent/SYSTEM.md" >&2
        exit 1
    fi

    mkdir -p "$WORKSPACE"

    # Remove BOTH adapter files, not just the one we are about to write.
    # Switching engines otherwise strands a stale sibling the other engine
    # may pick up.
    rm -f "$WORKSPACE/CLAUDE.md" "$WORKSPACE/AGENTS.md"

    body="$WORKSPACE/.sherman-body.$$"

    cat "$ROOT/agent/SYSTEM.md" > "$body"

    cat >> "$body" <<BODY

---

# Who you are speaking with

The operator of THIS machine is **$user**. Every reply is addressed to
$user — greetings, recaps, anything that carries a name carries $user's,
in every session on this machine, always.

Other people's names run all through the shared vault and memory:
attribution lines, other machines' operators, colleagues. Those say who
WROTE a fact, never who is in front of you now. Calling $user by a
colleague's name found in memory or in an example is a conduct bug —
misidentifying the person you work for — not a nicety to shrug off.

---

# Your knowledge base

These authoritative directories are shared with every other person's Sherman:

- \`$vault/wiki\` — the company knowledge base: procedures, SOPs, formats,
  policies, how things are done here.
- \`$vault/memory/shared\` — durable shared business memory.

**Search both before answering any question about this company.** Cite the file
you used.

Models read these directories but never modify them directly. When a complete,
durable company fact should be retained, offer a complete operator-reviewed
\`/wiki <name> | <fact>\` command. For a complete durable behavioral lesson,
offer a complete operator-reviewed \`/learn <name> | <lesson>\` command. The
operator decides whether to submit it; do not run the command yourself or omit
its complete content.

# Private memory for this user

- \`$vault/memory/private/$user\` — private to $user.

You may read this user's private context when relevant, but never read another
person's private memory directory. There is no validated private-memory
retention command yet, so do not propose or perform private-memory writes.

---

# Company skills

Your company skills travel with this workspace — \`.agents/skills\` for Codex,
\`.claude/skills\` for Claude Code — one directory per skill, each with a
\`SKILL.md\`. Before company work (vault lookups, SOPs, documents, anything
near the PHI boundary), read the matching skill and follow it: the skills are
how company work gets done the same way twice.

# Your own source

Sherman's source code lives at \`$ROOT\`. This workspace is generated from it
fresh on every launch and is disposable — never edit files here to change
Sherman; the change would not survive the next launch.

When asked to fix, improve, or extend Sherman itself, read the \`self-edit\`
skill and follow it: work in the source repo, verify with \`./smoke.sh\`,
commit on a branch, and never push — changes take effect on the next launch.

# HARD RULE — restated, because it is the floor

**Never store, request, repeat, or process patient-identifying information.**

The vault holds procedures, SOPs, formats, and company knowledge only — never
patient records, never results tied to a named patient, never anything that
could identify a patient.

If a request would require patient-identifying data, refuse it and say why:
this system is not HIPAA-compliant for PHI, and PHI must never enter it at all.

No user assurance and no phrasing makes an exception to this.
BODY

    # awk, not sed: the body is multi-line markdown full of & / and backslashes,
    # every one of which is special on sed's replacement side.
    awk -v bodyfile="$body" '
        $0 == "{{SHERMAN_BODY}}" {
            while ((getline line < bodyfile) > 0) print line
            close(bodyfile)
            next
        }
        { print }
    ' "$template" > "$out"

    rm -f "$body"

    # ----------------------------------------------------------- skills --
    # The engine discovers skills in its own working directory: Codex reads
    # .agents/skills (the Agent Skills convention), Claude Code .claude/skills.
    # Delivered as a COPY, not a symlink — the workspace is disposable
    # generated output, and a link would aim engine writes back at the repo.
    # Removed first so a skill deleted from the repo cannot survive a launch.
    rm -rf "$WORKSPACE/.agents/skills" "$WORKSPACE/.claude/skills"
    if [ -d "$ROOT/skills" ]; then
        mkdir -p "$WORKSPACE/.agents" "$WORKSPACE/.claude"
        if command -v node >/dev/null 2>&1; then
            # One inert file copier owns both layouts. It validates personal
            # frontmatter and every path, rejects links and bundled-name
            # collisions, and never imports or executes skill content.
            assembly_token="$(LC_ALL=C od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
            SHERMAN_SKILL_ASSEMBLY_TOKEN="$assembly_token" \
                node "$ROOT/shell/bin/sherman-commons.js" --assemble-skills "$assembly_token" \
                "$ROOT/skills" "$SHERMAN_HOME/skills" "$WORKSPACE/.agents/skills"
            assembly_token="$(LC_ALL=C od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
            SHERMAN_SKILL_ASSEMBLY_TOKEN="$assembly_token" \
                node "$ROOT/shell/bin/sherman-commons.js" --assemble-skills "$assembly_token" \
                "$ROOT/skills" "$SHERMAN_HOME/skills" "$WORKSPACE/.claude/skills"
            unset assembly_token
        else
            # Preserve raw-mode compatibility on a machine without Node. The
            # bundled repo remains usable; personal skills are not copied
            # without the validator that makes that boundary safe.
            cp -R "$ROOT/skills" "$WORKSPACE/.agents/skills"
            cp -R "$ROOT/skills" "$WORKSPACE/.claude/skills"
            [ ! -d "$SHERMAN_HOME/skills" ] \
                || echo "  NOTE: node not found; personal skills were not assembled this launch." >&2
        fi
    fi

    # --------------------------------------------------------- connectors --
    # What Sherman can reach outside itself, rendered from agent/connectors.json
    # (the committed catalog) and ~/.sherman/connectors.json (this machine's
    # enablement and secrets). See docs/CONNECTORS.md.
    #
    # This used to be a fifty-line block that knew the LLM Wiki by name. The
    # wiki is now one catalog entry, gated by the same probe it always was, and
    # adding a connector is data rather than another branch here. That is what
    # gives the `0-1` skill a surface to add one TO.
    #
    # The resolver lives in JS because it substitutes paths, checks secrets, and
    # emits JSON and TOML — none of which bash 3.2 (C4) should be doing. One
    # node start per launch, the same cost the wiki probe already paid.
    #
    # Claude Code reads .mcp.json from its working directory; codex reads
    # [mcp_servers.*] from its own config, which the resolver stages per
    # connector and this function appends — backed up first, claimed only after
    # read-back (the write_codex_model contract).
    rm -f "$WORKSPACE/.mcp.json"
    rm -rf "$WORKSPACE/.codex-mcp"
    if [ ! -f "$ROOT/shell/src/connectors.js" ]; then
        : # nothing to render from
    elif ! command -v node >/dev/null 2>&1; then
        echo "  NOTE: node not found; no MCP connectors were wired this launch." >&2
    else
        # Failure renders NOTHING rather than something partial: a half-written
        # .mcp.json fails at engine startup, a long way from its cause.
        #
        # `2>&1 >file` before the substitution closes: stderr goes to the
        # capture, stdout (the wired names, which this loop does not need — it
        # walks .codex-mcp instead) goes to the scratch file. So conn_notes
        # holds exactly the NOTE lines, which are relayed as our own.
        conn_notes=$(SHERMAN_REPO_ROOT="$ROOT" SHERMAN_HOME="$SHERMAN_HOME" \
            node "$ROOT/shell/src/connectors.js" --render "$WORKSPACE" 2>&1 >"$WORKSPACE/.connectors.out")
        if [ -n "$conn_notes" ]; then
            printf '%s\n' "$conn_notes" >&2
        fi
        conn_cfg=$(codex_config_path)
        if [ -d "$WORKSPACE/.codex-mcp" ]; then
            for block in "$WORKSPACE/.codex-mcp"/*.toml; do
                [ -f "$block" ] || continue
                conn_name=$(basename "$block" .toml)
                if [ -f "$conn_cfg" ] && grep -q "^\[mcp_servers\.$conn_name\]" "$conn_cfg" 2>/dev/null; then
                    continue # already registered; the entry is the user's to edit now
                fi
                mkdir -p "$(dirname "$conn_cfg")"
                [ -f "$conn_cfg" ] && cp "$conn_cfg" "$conn_cfg.sherman-backup"
                cat "$block" >> "$conn_cfg"
                grep -q "^\[mcp_servers\.$conn_name\]" "$conn_cfg" 2>/dev/null \
                    || echo "  NOTE: could not register the $conn_name MCP in $conn_cfg" >&2
            done
        fi
        rm -f "$WORKSPACE/.connectors.out"
    fi

    # Commons is first-party but never enabled from local settings alone. The
    # helper requires both a valid local device identity and a fresh signed,
    # bounded heartbeat against the configured audience before it writes an
    # engine entry. Failure is deliberately nonfatal; it also removes only
    # entries carrying Sherman's ownership marker, leaving user MCP config alone.
    # process.execPath inside the helper supplies an absolute Node command and
    # the helper derives the absolute stdio server path from its own location.
    if command -v node >/dev/null 2>&1; then
        node "$ROOT/shell/bin/sherman-commons.js" --reconcile-mcp "$engine" "$WORKSPACE" || true
    fi

    # Bind OpenCode to the connector bytes this launcher just rendered. The
    # Shell snapshots only a matching file, so a later model edit cannot turn
    # into an executable MCP server on the next turn.
    unset SHERMAN_MCP_CONFIG_SHA256
    if [ "$engine" = "zai" ] && [ -f "$WORKSPACE/.mcp.json" ] \
        && command -v node >/dev/null 2>&1; then
        SHERMAN_MCP_CONFIG_SHA256=$(node -e '
const fs = require("node:fs");
const crypto = require("node:crypto");
process.stdout.write(crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex"));
' "$WORKSPACE/.mcp.json") || SHERMAN_MCP_CONFIG_SHA256=""
        export SHERMAN_MCP_CONFIG_SHA256
    fi
}

# --------------------------------------------------------------------- main --
# Commons is a standalone local client. It needs Node for bounded JSON, crypto,
# and HTTP, but never an engine, Sherman config, or shell dependency install.
# Dispatch before every engine/setup path so an unenrolled machine can inspect
# status and enroll without being dropped into the first-run wizard.
if [ "${1:-}" = "commons" ]; then
    shift
    if ! command -v node >/dev/null 2>&1; then
        echo "Sherman Commons needs Node.js 22 or newer, and node is not on your PATH." >&2
        exit 1
    fi
    exec node "$ROOT/shell/bin/sherman-commons.js" "$@"
fi

# `pet` runs the floating desktop companion (pet/sherman-pet.swift): compiled
# locally with the system Swift toolchain on first run (and again whenever the
# source changes — the binary name carries the source hash), then launched
# detached so it outlives this command. It needs no engine and no config, so
# it dispatches early like update. The pet is a viewer: the shell writes
# ~/.sherman/pet/state.json and the pet renders it; creating that directory
# here is what turns those writes on (see shell/src/petstate.js).
run_pet() {
    pet_dir="$SHERMAN_HOME/pet"
    pet_src="$ROOT/pet/sherman-pet.swift"
    case "${1:-start}" in
        stop)
            if [ -f "$pet_dir/pet.pid" ] && kill "$(cat "$pet_dir/pet.pid")" 2>/dev/null; then
                rm -f "$pet_dir/pet.pid"
                echo "pet stopped."
            else
                rm -f "$pet_dir/pet.pid"
                echo "the pet is not running."
            fi
            exit 0 ;;
        start) ;;
        *)
            echo "Usage: sherman pet [start|stop]" >&2
            exit 1 ;;
    esac
    if [ "$(uname -s)" != "Darwin" ]; then
        echo "The desktop pet is macOS-only for now. The /pet skill works everywhere."
        exit 1
    fi
    if [ ! -f "$pet_src" ]; then
        echo "Pet source missing: $pet_src" >&2
        exit 1
    fi
    if ! command -v swiftc >/dev/null 2>&1; then
        echo "The pet compiles locally and needs the Xcode Command Line Tools."
        echo "Install them with:  xcode-select --install   then run sherman pet again."
        exit 1
    fi
    mkdir -p "$pet_dir"
    # Seed the state with the terminal this command ran from, so the very
    # first click can bring the right app forward before any shell session
    # has written a state of its own. TERM_PROGRAM does not survive every
    # multiplexer, so the terminal-specific env vars back it up — mirroring
    # shell/src/petstate.js detectTerminal. A state whose terminal is EMPTY
    # is re-seeded too: an empty recording aims clicks at the wrong app.
    seed_term="${TERM_PROGRAM:-}"
    if [ -z "$seed_term" ]; then
        if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then seed_term="ghostty"
        elif [ -n "${WEZTERM_EXECUTABLE:-}" ]; then seed_term="WezTerm"
        elif [ -n "${KITTY_PID:-}" ]; then seed_term="kitty"
        elif [ -n "${ALACRITTY_WINDOW_ID:-}" ]; then seed_term="Alacritty"
        elif [ -n "${ITERM_SESSION_ID:-}" ]; then seed_term="iTerm.app"
        fi
    fi
    if [ ! -f "$pet_dir/state.json" ] \
        || grep -q '"terminal":""' "$pet_dir/state.json" 2>/dev/null; then
        printf '{"status":"offline","detail":"","terminal":"%s","session":"","updatedAt":%s}\n' \
            "$seed_term" "$(($(date +%s) * 1000))" > "$pet_dir/state.json"
    fi
    pet_hash=$(shasum "$pet_src" 2>/dev/null | cut -c1-12)
    pet_bin="$pet_dir/sherman-pet-$pet_hash"
    if [ ! -x "$pet_bin" ]; then
        echo "compiling the pet (first run, or the pet changed) ..."
        if ! swiftc -swift-version 5 -O "$pet_src" -o "$pet_bin"; then
            echo "the pet did not compile; nothing was started." >&2
            exit 1
        fi
        # Old builds are dead weight once a new hash exists.
        for old in "$pet_dir"/sherman-pet-*; do
            [ "$old" = "$pet_bin" ] || rm -f "$old"
        done
    fi
    # One pet at a time: retire a previous instance before starting.
    if [ -f "$pet_dir/pet.pid" ]; then
        kill "$(cat "$pet_dir/pet.pid")" 2>/dev/null || true
        rm -f "$pet_dir/pet.pid"
    fi
    nohup "$pet_bin" >/dev/null 2>&1 &
    pet_pid=$!
    echo "$pet_pid" > "$pet_dir/pet.pid"
    sleep 1
    if kill -0 "$pet_pid" 2>/dev/null; then
        echo "pet started (verified: compiled binary running, pid $pet_pid)."
        echo "  drag it anywhere · click brings Sherman forward · right-click sizes it"
        echo "  it shows live status from your next sherman session · sherman pet stop ends it"
    else
        rm -f "$pet_dir/pet.pid"
        echo "the pet started and immediately exited; run $pet_bin by hand to see why." >&2
        exit 1
    fi
    exit 0
}

if [ "${1:-}" = "pet" ]; then
    shift
    run_pet "$@"
fi

# `board` -- the operator's live window into a team of Sherman sessions
# coordinating through a shared board file (see the team and kanban skills).
# Needs no engine and no config: it renders `$WORKSPACE/boards/*.md` in place,
# refreshing every two seconds on a TTY, printing once when piped. Reading is
# all it does; the sessions own the writes.
run_board() {
    boards_dir="$WORKSPACE/boards"
    pick="${1:-}"

    board_file=""
    if [ -n "$pick" ]; then
        for candidate in "$boards_dir/team-$pick.md" "$boards_dir/$pick.md" "$pick"; do
            if [ -f "$candidate" ]; then
                board_file="$candidate"
                break
            fi
        done
        if [ -z "$board_file" ]; then
            echo "No board named '$pick' under $boards_dir." >&2
            exit 1
        fi
    else
        # Newest board wins; team boards outrank solo boards at the same age
        # only by being what this command exists to watch.
        board_file=$(ls -t "$boards_dir"/team-*.md 2>/dev/null | head -1)
        [ -n "$board_file" ] || board_file=$(ls -t "$boards_dir"/*.md 2>/dev/null | head -1)
        if [ -z "$board_file" ]; then
            echo "No boards yet. A Sherman session creates one when a project"
            echo "spans workstreams (kanban skill) or when you tell sessions to"
            echo "work as a team (team skill). Boards live in $boards_dir."
            exit 0
        fi
    fi

    render_board() {
        # Light ink, honest content: headings and statuses colored, every
        # byte of the board shown as written. NO_COLOR drops the tint.
        if [ -n "${NO_COLOR:-}" ]; then
            cat "$board_file"
        else
            awk '
                /^#/      { printf "\033[1;36m%s\033[0m\n", $0; next }
                /\| *done *\|/        { gsub(/\| *done *\|/, "| \033[32mdone\033[0m |") }
                /\| *in-progress *\|/ { gsub(/\| *in-progress *\|/, "| \033[33min-progress\033[0m |") }
                /\| *verify *\|/      { gsub(/\| *verify *\|/, "| \033[35mverify\033[0m |") }
                /blocked/  { gsub(/blocked/, "\033[31mblocked\033[0m") }
                { print }
            ' "$board_file"
        fi
    }

    if [ -t 1 ]; then
        while :; do
            printf '\033[H\033[2J'
            printf '\033[2m%s · refreshed %s · ctrl+c to stop watching\033[0m\n\n' \
                "$board_file" "$(date '+%H:%M:%S')"
            render_board
            sleep 2
        done
    else
        # Piped output is for machines and transcripts: the bytes as written,
        # no escape codes to clean up later.
        cat "$board_file"
    fi
    exit 0
}

if [ "${1:-}" = "board" ]; then
    shift
    run_board "$@"
fi

# `update` is a subcommand, recognised first: it needs no engine, no config and
# no session, so it runs before any of them are checked or created.
if [ "${1:-}" = "update" ]; then
    run_update
fi

# `sync` likewise: vault sharing needs git and a remote, not an engine.
if [ "${1:-}" = "sync" ]; then
    run_sync
fi

# `model` -- interactive picker with no argument, direct set with one.
# The picker walks provider -> sign-in -> model: the provider menu renders
# from the same registry as setup (an unavailable provider is shown and
# refuses selection, never sold), the sign-in check is codex's own
# `codex login status`, and the model menu lists the models this shell
# knows context windows for -- read live from shell/src/config.js, so one
# map feeds both -- stated as "known here", because codex 0.145 offers no
# way to enumerate models and this menu does not pretend otherwise.
run_model_picker() {
    echo
    echo "Provider:"
    total=$(provider_count)
    i=1
    while [ "$i" -le "$total" ]; do
        if [ "$(provider_field "$i" 4)" = "available" ]; then
            echo "  [$i] $(provider_field "$i" 2)"
        else
            echo "  [$i] $(provider_field "$i" 2) — not available yet"
        fi
        i=$((i + 1))
    done
    picked=""
    while [ -z "$picked" ]; do
        printf 'Choose a number > '
        if ! read -r reply; then echo; exit 1; fi
        case "$reply" in ''|*[!0-9]*) echo "  Enter a number between 1 and $total."; continue ;; esac
        if [ "$reply" -lt 1 ] || [ "$reply" -gt "$total" ]; then
            echo "  Enter a number between 1 and $total."; continue
        fi
        if [ "$(provider_field "$reply" 4)" != "available" ]; then
            echo "  $(provider_field "$reply" 2) is not available yet — $(provider_field "$reply" 5)."
            continue
        fi
        picked=$(provider_field "$reply" 1)
    done

    if [ "$picked" = "zai" ]; then
        ensure_opencode || exit 1
        ensure_zai_auth || exit 1
        config_set engine zai
        ask_zai_plan
        echo "  provider: Z.AI"
        echo "  model: glm-5.2 (via OpenCode)"
        echo "  saved and verified. Run sherman to start."
        exit 0
    fi

    ensure_linux_codex || exit 1
    if ! command -v codex >/dev/null 2>&1; then
        engine_install_hint codex
        exit 1
    fi
    if codex login status >/dev/null 2>&1; then
        echo "  signed in ($(codex login status 2>/dev/null | head -1))"
    else
        printf 'Not signed in. Run codex login now (opens a browser)? [y/N] > '
        read -r yn || yn=""
        case "$yn" in
            y|Y|yes|YES)
                codex login || { echo "  login did not complete; try again later."; exit 1; }
                ;;
            *)
                echo "  staying signed out -- codex will run its login on first use."
                ;;
        esac
    fi

    config_set engine codex
    current=$(read_codex_model)
    echo
    if [ -n "$current" ]; then
        echo "Model [current: $current] -- the models this shell knows"
    else
        echo "Model [current: codex default] -- the models this shell knows"
    fi
    echo "(codex accepts others too; type a name instead of a number):"
    known_models=$(sed -n "/MODEL_CONTEXT_WINDOWS/,/})/s/^[[:space:]]*'\([^']*\)':.*/\1/p" "$ROOT/shell/src/config.js")
    i=1
    for m in $known_models; do
        echo "  [$i] $m"
        i=$((i + 1))
    done
    count=$((i - 1))
    printf 'Choose a number, type a model name, or Enter to keep as is > '
    read -r choice || choice=""
    choice=$(printf '%s' "$choice" | tr -d '" ')
    [ -z "$choice" ] && { echo "  keeping it as is."; exit 0; }
    case "$choice" in
        *[!0-9]*)
            write_codex_model "$choice"; exit $? ;;
        *)
            if [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
                sel=$(printf '%s\n' $known_models | sed -n "${choice}p")
                write_codex_model "$sel"; exit $?
            fi
            echo "  Enter 1-$count, a model name, or nothing."
            exit 1 ;;
    esac
}

if [ "${1:-}" = "model" ]; then
    shift
    configured_engine=$(config_get engine)
    if [ -z "${1:-}" ]; then
        if [ -t 0 ]; then
            run_model_picker
        fi
        if [ "$configured_engine" = "zai" ]; then
            echo "provider: Z.AI"
            echo "model: glm-5.2 (pinned by Sherman)"
            echo "change provider interactively with: sherman model"
            exit 0
        fi
        current=$(read_codex_model)
        if [ -n "$current" ]; then
            echo "model: $current (from $(codex_config_path))"
        else
            echo "model: codex default (no top-level model in $(codex_config_path))"
        fi
        echo "change it with: sherman model <name>   (e.g. sherman model gpt-5.6-sol)"
        exit 0
    fi
    case "$1" in
        zai)
            ensure_opencode || exit 1
            ensure_zai_auth || exit 1
            config_set engine zai
            ask_zai_plan
            echo "provider: Z.AI · model: glm-5.2 (verified: Sherman config)"
            exit 0 ;;
        codex)
            ensure_linux_codex || exit 1
            config_set engine codex
            echo "provider: OpenAI (Codex) (verified: Sherman config)"
            exit 0 ;;
    esac
    if [ "$configured_engine" = "zai" ]; then
        if [ "$1" = "glm-5.2" ]; then
            echo "model: glm-5.2 (already pinned by Sherman)"
            exit 0
        fi
        echo "Z.AI is pinned to glm-5.2. Run 'sherman model' to switch providers." >&2
        exit 1
    fi
    if write_codex_model "$1"; then exit 0; else exit 1; fi
fi

# `telegram` runs the messaging bridge over the same assembled adapter the
# shell uses -- same persona, same no-PHI contract, same engine session
# layer. --token saves the bot token; pairing normally happens by texting
# the code the bridge shows (--allow remains the manual override). The
# bare form falls through the normal launch path (wizard if unconfigured,
# engine check, adapter assembly) and then execs the bridge instead of the
# shell. DESIGN.md's rule is honored, not dodged: the connect flow exists
# because the bridge now does.
TELEGRAM=0
if [ "${1:-}" = "telegram" ]; then
    shift
    case "${1:-}" in
        --token)
            if [ -z "${2:-}" ]; then
                echo "Usage: sherman telegram --token <bot-token>   (from @BotFather)" >&2
                exit 1
            fi
            config_set telegram_token "$2"
            echo "token saved (verified: read back from config). Next: sherman telegram"
            exit 0
            ;;
        --allow)
            if [ -z "${2:-}" ]; then
                echo "Usage: sherman telegram --allow <chat-id>" >&2
                exit 1
            fi
            config_set telegram_chat "$2"
            echo "chat $2 paired (verified: read back from config). Restart sherman telegram."
            exit 0
            ;;
    esac
    TELEGRAM=1
fi

# `brief` runs ONE headless morning-brief turn and exits -- the schedulable
# shape (Windows Task Scheduler, cron). It prints the brief and, when a bot
# token and a paired chat exist in the config, delivers it to Telegram; a
# missing half is named with its one repair command (see bridge/brief.js).
# Falls through the normal launch path like telegram does, so the turn runs
# over the same assembled adapter and no-PHI contract.
BRIEF=0
if [ "${1:-}" = "brief" ]; then
    shift
    BRIEF=1
fi

# --raw is recognised as the FIRST argument only, and stripped before the engine
# sees the rest. Everything else passes straight through, unchanged.
RAW=0
if [ "${1:-}" = "--raw" ]; then
    RAW=1
    shift
fi

# In raw mode nothing downstream draws our brand, so the launcher does it. In
# shell mode the shell owns the screen and renders the mark itself -- doing it
# here as well would print the banner twice on every launch.
if [ "$RAW" -eq 1 ]; then
    launch_screen
fi

# A corrupt config self-heals right here: quarantined, then setup runs
# again exactly as if this were a first run. Nobody is told to delete a
# file this script can move itself.
quarantine_corrupt_config
if [ -n "$config_quarantined" ]; then
    echo "Setup will ask its questions again; the moved file is kept for diagnosis."
    echo
fi

if [ ! -f "$CONFIG" ]; then
    [ "$RAW" -eq 1 ] || wizard_header
    run_wizard
fi

ENGINE=$(config_get engine)
USER_SLUG=$(config_get user)
VAULT=$(config_get vault_path)

if [ -z "$ENGINE" ] || [ -z "$USER_SLUG" ] || [ -z "$VAULT" ]; then
    echo "Config at $CONFIG is incomplete. Delete it and run sherman again." >&2
    exit 1
fi

# A config from before the newer setup questions gets them asked once, now,
# rather than silently never -- "it didn't ask me" is a bug report this
# launcher takes seriously. Non-interactive runs skip; they cannot answer.
cfg_version=$(config_get version)
case "$cfg_version" in
    ''|0|1)
        if [ -t 0 ]; then
            run_setup_upgrade
        fi
        ;;
esac

require_engine "$ENGINE"
if [ "$ENGINE" = "zai" ]; then
    ensure_zai_auth || exit 1
fi

# Freshen the remote-tracking refs in the background, so the launch panel's
# update notice can be a real measurement (HEAD..@{upstream} from local refs)
# instead of a network call in the render path. Backgrounded and silenced:
# a launch must never wait on the network or print fetch noise, and offline
# the refs simply stay as they were -- the panel then reports the truth as
# of the last successful fetch, which may be one launch behind but is never
# invented. SHERMAN_NO_FETCH opts out entirely (tests, air-gapped machines).
if [ -z "${SHERMAN_NO_FETCH:-}" ] && [ -d "$ROOT/.git" ]; then
    (git -C "$ROOT" fetch --quiet >/dev/null 2>&1 &)
fi

# One id per launch, minted HERE so the same id reaches all three places it was
# promised: the adapter's attribution rule (assembled below), both handoffs
# (via the environment), and the shell's launch panel and session log. Per-launch
# state only -- it is never written to config.json.
SESSION_ID="$(date +%Y%m%d_%H%M%S)_$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
SESSION_DATE="$(date +%Y-%m-%d)"
export SHERMAN_SESSION_ID="$SESSION_ID"

# Idempotent: keeps adapter paths resolvable even if the vault moved or was
# cleared. Directories only -- the vault's contents are not this script's job.
mkdir -p "$VAULT/wiki" "$VAULT/memory/shared" "$VAULT/memory/private/$USER_SLUG"

assemble_adapter "$ENGINE" "$USER_SLUG" "$VAULT" "$SESSION_ID" "$SESSION_DATE"

# Either handoff runs from the workspace, so the engine's cwd is identical in
# both modes -- that is what makes it pick up the adapter we just assembled.
cd "$WORKSPACE"

if [ "$RAW" -eq 1 ]; then
    exec "$(engine_binary "$ENGINE")" "$@"
fi

require_node

if [ "$TELEGRAM" -eq 1 ]; then
    exec node "$ROOT/bridge/telegram.js"
fi

if [ "$BRIEF" -eq 1 ]; then
    exec node "$ROOT/bridge/brief.js"
fi

exec node "$ROOT/shell/bin/sherman-shell.js" "$@"
