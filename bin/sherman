#!/usr/bin/env bash
#
# sherman — launch Sherman Abrams, the company agent.
#
# Sherman is not its own engine. It is a branded, memory-wired layer over
# whichever coding CLI you already have. This script runs the one-time wizard if
# needed, assembles the engine adapter fresh from the repo, and hands off.
#
# The handoffs and subcommands:
#
#   sherman           the Sherman Shell — our UI, engine headless underneath
#   sherman --raw     exec the engine directly, its own chrome, for debugging
#   sherman update    fast-forward this checkout from its remote
#   sherman sync      pull + publish the shared vault (wiki, shared memory, inbox)
#   sherman model     read or set the codex model, verified by read-back
#   sherman telegram  the Telegram bridge, same adapter and engine layer as the shell
#
# Target shell: macOS system bash 3.2. No ${var,,}, no associative arrays,
# no readlink -f.

set -euo pipefail

# ---------------------------------------------------------------- repo root --
# $0 is usually a symlink on PATH, so chase the chain by hand. `readlink -f`
# does not exist on BSD/macOS.
resolve_root() {
    src="$0"
    while [ -L "$src" ]; do
        dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")/.." && pwd
}

ROOT=$(resolve_root)

# All state hangs off $HOME, read live every time. Never hardcode a home
# directory: smoke.sh overrides HOME to sandbox its run, and a hardcoded path
# would both defeat the test and scribble on the real config.
SHERMAN_HOME="${HOME}/.sherman"
CONFIG="${SHERMAN_HOME}/config.json"
WORKSPACE="${SHERMAN_HOME}/workspace"

# ------------------------------------------------------- self-owned runtime --
# install.sh may have provisioned Node -- and npm-global tools like the codex
# CLI -- into ~/.sherman/runtime, linked into a bin directory that no shell
# startup file is guaranteed to put on PATH. Seen on the first real WSL
# machine: a broken ~/.profile kept every PATH line from ever applying, and
# the shell then claimed Node was missing while sitting next to the Node
# that installed it. The launcher finds its own runtime rather than trusting
# the shell that started it.
for runtime_bin in "$SHERMAN_HOME"/runtime/node-*/bin; do
    if [ -x "$runtime_bin/node" ]; then
        case ":$PATH:" in
            *":$runtime_bin:"*) ;;
            *) PATH="$runtime_bin:$PATH"; export PATH ;;
        esac
    fi
done

# ------------------------------------------------------------ launch screen --
launch_screen() {
    if [ -f "$ROOT/logo/banner.ans" ]; then
        cat "$ROOT/logo/banner.ans"
    else
        cat <<'PLACEHOLDER'

   SHERMAN ABRAMS
   Sherman Abrams Labs — company agent

PLACEHOLDER
    fi
}

# ------------------------------------------------------------------ engines --
# The provider registry. One line per provider:
#
#     id|label|binary|status|reason
#
# The wizard's menu renders FROM this list, so adding a provider later — or
# flipping one to available the day its backend is real — is one line here,
# never new wizard flow. An unavailable provider is listed with its reason and
# refuses selection: a selectable option that errors after selection is the
# one dishonest shape the menu is not allowed to have.
#
# bash 3.2: plain string + line tools, no associative arrays. No `|` inside
# any field.
PROVIDERS='codex|OpenAI (Codex)|codex|available|
claude|Anthropic (Claude Code)|claude|unavailable|the Claude Code backend is not wired into the Sherman Shell yet; Codex is the only working backend today'

provider_count() {
    printf '%s\n' "$PROVIDERS" | grep -c .
}

# $1 = 1-based registry line, $2 = field number (1 id, 2 label, 3 binary,
# 4 status, 5 reason).
provider_field() {
    printf '%s\n' "$PROVIDERS" | sed -n "${1}p" | cut -d'|' -f"$2"
}

engine_binary() {
    printf '%s\n' "$PROVIDERS" \
        | awk -F'|' -v id="$1" '$1 == id { print $3; found = 1 } END { if (!found) print "unknown-engine" }'
}

engine_install_hint() {
    case "$1" in
        claude)
            echo "Claude Code is not installed. Install it with:"
            echo
            echo "    curl -fsSL https://claude.ai/install.sh | bash"
            echo
            echo "  (or: npm install -g @anthropic-ai/claude-code)"
            ;;
        codex)
            echo "Codex is not installed. Install it with:"
            echo
            echo "    npm install -g @openai/codex"
            ;;
    esac
}

# Seen on the first real Windows machine: with WSL's PATH interop on,
# `codex` inside Ubuntu resolved to the WINDOWS npm's shim under /mnt/c/...,
# which dies on its first import with "Missing optional dependency
# @openai/codex-linux-x64" -- the package behind it is the Windows build.
# That shim is not an install, it is a trap, and install.sh now refuses to
# count it. This guard heals machines installed before that: if the codex
# on PATH lives under /mnt, install the Linux one right here with the
# runtime's own npm (already prepended to PATH above) and verify it runs.
ensure_linux_codex() {
    found=$(command -v codex 2>/dev/null || true)
    case "$found" in
        /mnt/*) ;;
        *) return 0 ;;  # absent or already a Linux codex: nothing to heal
    esac
    echo "  the codex on PATH is Windows' own install ($found)"
    echo "  and cannot run inside Ubuntu. Installing the Linux codex CLI"
    echo "  (npm install -g @openai/codex) ..."
    npm_bin=$(command -v npm 2>/dev/null || true)
    case "$npm_bin" in /mnt/*) npm_bin="" ;; esac
    if [ -z "$npm_bin" ]; then
        echo "  ...but there is no Linux npm to install it with."
        echo "  Run ./install.sh in the sherman repo, then sherman again."
        return 1
    fi
    "$npm_bin" install -g @openai/codex >/dev/null 2>&1 || true
    hash -r 2>/dev/null || true
    found=$(command -v codex 2>/dev/null || true)
    case "$found" in
        /mnt/*|'')
            echo "  ...npm ran but no Linux codex appeared on PATH."
            echo "  Install it by hand:  npm install -g @openai/codex"
            return 1 ;;
    esac
    if codex --version >/dev/null 2>&1; then
        echo "  ...codex $(codex --version 2>/dev/null) installed at $found (verified: codex --version)"
        return 0
    fi
    echo "  ...a codex appeared at $found but did not run. Install it by hand:"
    echo "     npm install -g @openai/codex"
    return 1
}

require_engine() {
    bin=$(engine_binary "$1")
    if [ "$bin" = "codex" ]; then
        ensure_linux_codex || exit 1
    fi
    if ! command -v "$bin" >/dev/null 2>&1; then
        echo >&2
        engine_install_hint "$1" >&2
        echo >&2
        echo "Then run sherman again." >&2
        exit 1
    fi
}

# --------------------------------------------------------------------- node --
# The shell is a Node app. If Node is missing or too old we say so and stop --
# we do NOT quietly exec the engine instead. A silent fallback would drop you
# into the engine's own chrome while you believed you were in Sherman, which is
# the exact problem the shell exists to solve. --raw stays available; choosing
# it should be your decision, not a surprise.
require_node() {
    if ! command -v node >/dev/null 2>&1; then
        echo >&2
        echo "The Sherman Shell needs Node.js 22 or newer, and node is not on your PATH." >&2
        echo >&2
        echo "Install Node 22+, then run sherman again." >&2
        echo >&2
        echo "To keep working without the shell in the meantime:" >&2
        echo >&2
        echo "    sherman --raw" >&2
        echo >&2
        exit 1
    fi

    # `node --version` prints like "v22.23.1". Strip the v, take the major.
    # Cut and sed, not bash arithmetic on a string -- bash 3.2 would happily
    # evaluate "v22" as 0 and silently pass a version check.
    node_version=$(node --version 2>/dev/null)
    node_major=$(printf '%s' "$node_version" | sed 's/^v//' | cut -d. -f1)

    case "$node_major" in
        ''|*[!0-9]*)
            echo >&2
            echo "Could not read a Node.js version from: $node_version" >&2
            echo "The Sherman Shell needs Node 22 or newer. Try: sherman --raw" >&2
            echo >&2
            exit 1
            ;;
    esac

    if [ "$node_major" -lt 22 ]; then
        echo >&2
        echo "The Sherman Shell needs Node.js 22 or newer. Found $node_version." >&2
        echo >&2
        echo "Upgrade Node, then run sherman again." >&2
        echo >&2
        echo "To keep working without the shell in the meantime:" >&2
        echo >&2
        echo "    sherman --raw" >&2
        echo >&2
        exit 1
    fi

    if [ ! -d "$ROOT/shell/node_modules" ]; then
        echo >&2
        echo "The Sherman Shell's dependencies are not installed." >&2
        echo >&2
        echo "Run:" >&2
        echo >&2
        echo "    $ROOT/install.sh" >&2
        echo >&2
        echo "Or work without the shell for now:" >&2
        echo >&2
        echo "    sherman --raw" >&2
        echo >&2
        exit 1
    fi
}

# A compact stand-in for the banner. Used only when the wizard runs on the way
# into the shell: the shell draws the full mark itself, and printing it here too
# would show it twice on a first run.
wizard_header() {
    echo
    echo "  SHERMAN ABRAMS"
    echo "  Sherman Abrams Labs — company agent"
}

# ------------------------------------------------------------------- wizard --
slugify() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr ' ' '-' \
        | tr -cd 'a-z0-9_-'
}

run_wizard() {
    echo
    echo "Setting up Sherman on this machine."
    echo

    # 1. Provider. This IS the engine choice. Sherman performs no OAuth of its
    #    own -- the engine's native browser login fires on first launch if it
    #    is not already authenticated.
    #
    #    The menu renders from the provider registry. Unavailable providers are
    #    shown -- silence would read as "does not exist" -- but refuse
    #    selection with their reason and re-prompt.
    echo "Sign in with:"
    total=$(provider_count)
    i=1
    while [ "$i" -le "$total" ]; do
        if [ "$(provider_field "$i" 4)" = "available" ]; then
            echo "  [$i] $(provider_field "$i" 2)"
        else
            echo "  [$i] $(provider_field "$i" 2) — not available yet"
        fi
        i=$((i + 1))
    done

    engine=""
    while [ -z "$engine" ]; do
        printf 'Choose a number > '
        if ! read -r reply; then
            echo >&2
            echo "No answer given. Aborting." >&2
            exit 1
        fi
        case "$reply" in
            ''|*[!0-9]*)
                echo "  Enter a number between 1 and $total."
                continue
                ;;
        esac
        if [ "$reply" -lt 1 ] || [ "$reply" -gt "$total" ]; then
            echo "  Enter a number between 1 and $total."
            continue
        fi
        if [ "$(provider_field "$reply" 4)" != "available" ]; then
            echo "  $(provider_field "$reply" 2) is not available yet — $(provider_field "$reply" 5)."
            continue
        fi
        engine=$(provider_field "$reply" 1)
    done

    # Fail before writing any config if the engine is missing.
    require_engine "$engine"

    # 2. Who you are. Becomes a directory name, so slugify it.
    user=""
    while [ -z "$user" ]; do
        printf 'Your name > '
        if ! read -r raw; then
            echo >&2
            echo "No answer given. Aborting." >&2
            exit 1
        fi
        user=$(slugify "$raw")
        [ -z "$user" ] && echo "  Need at least one letter or number."
    done

    ask_model
    ask_telegram

    vault="$ROOT/vault"

    mkdir -p "$SHERMAN_HOME"
    extra=""
    [ -n "$tg_token" ] && extra=$(printf ',"telegram_token":"%s"' "$tg_token")
    printf '{"version":2,"engine":"%s","user":"%s","vault_path":"%s"%s}\n' \
        "$engine" "$user" "$vault" "$extra" > "$CONFIG"

    echo
    echo "  engine: $engine"
    echo "  user:   $user"
    echo "  vault:  $vault"
    if [ -n "$tg_token" ]; then
        echo "  telegram: token saved -- after setup, run: sherman telegram"
        echo "            (first message to the bot prints the chat id to pair)"
    fi
    echo
    echo "Starting your session."
    echo
}

# Codex owns the model choice: the shell reads it back from codex's own
# config and never forces -m, so the one honest place to record a
# preference is that config. Top-level key only; the file is backed up
# before any edit and every claim follows a read-back.
codex_config_path() { printf '%s' "${CODEX_HOME:-$HOME/.codex}/config.toml"; }

read_codex_model() {
    cfg=$(codex_config_path)
    [ -f "$cfg" ] || return 0
    sed -n '/^\[/q; s/^[[:space:]]*model[[:space:]]*=[[:space:]]*"\{0,1\}\([^"#]*\)"\{0,1\}[[:space:]]*$/\1/p' "$cfg" | head -1
}

# Refuses input that cannot be a model name. Learned on the first real
# Windows machine, where a stray keystroke became model = "k" in codex's
# config and would have failed every turn: a single character or anything
# without a digit is a typo, not a model, and writing it is worse than
# asking again.
write_codex_model() {
    new_model="$1"
    cfg=$(codex_config_path)
    case "$new_model" in
        ''|*[!A-Za-z0-9._-]*)
            echo "  '$new_model' does not look like a model name; nothing was changed."
            return 1 ;;
    esac
    case "$new_model" in
        *[0-9]*) ;;
        *)
            echo "  '$new_model' does not look like a model name (no digit); nothing was changed."
            return 1 ;;
    esac
    if [ "${#new_model}" -lt 2 ]; then
        echo "  '$new_model' does not look like a model name; nothing was changed."
        return 1
    fi
    current_model=$(read_codex_model)
    mkdir -p "$(dirname "$cfg")"
    if [ -f "$cfg" ]; then
        cp "$cfg" "$cfg.sherman-backup"
        if [ -n "$current_model" ]; then
            # Replace the top-level line only; section keys are that
            # section's business, exactly as the shell reads it.
            awk -v m="$new_model" '
                /^\[/ { insec = 1 }
                !insec && /^[[:space:]]*model[[:space:]]*=/ && !done {
                    print "model = \"" m "\""; done = 1; next
                }
                { print }' "$cfg" > "$cfg.sherman-tmp" \
                && mv "$cfg.sherman-tmp" "$cfg"
        else
            { printf 'model = "%s"\n' "$new_model"; cat "$cfg.sherman-backup"; } > "$cfg"
        fi
    else
        printf 'model = "%s"\n' "$new_model" > "$cfg"
    fi
    written=$(read_codex_model)
    if [ "$written" = "$new_model" ]; then
        echo "  model $new_model set (verified: read back from codex's own config)"
        return 0
    fi
    echo "  could not verify the model landed in $cfg -- codex's default stays in effect."
    return 1
}

# Model question (codex only). Reads $engine.
ask_model() {
    if [ "$engine" = "codex" ]; then
        current_model=$(read_codex_model)
        echo
        if [ -n "$current_model" ]; then
            printf 'Codex model [current: %s] — Enter keeps it, or type another > ' "$current_model"
        else
            printf 'Codex model — Enter keeps the codex default, or type one (e.g. gpt-5.6-sol) > '
        fi
        read -r model_reply || model_reply=""
        model_reply=$(printf '%s' "$model_reply" | tr -d '"' | tr -d ' ')
        if [ -n "$model_reply" ]; then
            write_codex_model "$model_reply" || true
        fi
    fi
}

# Telegram question (optional). The connect flow is offered because the
# bridge exists (bridge/telegram.js) -- DESIGN.md's rule, honored in that
# order. Enter skips; nothing is ever required here. Guided step-by-step
# because "paste a token" assumes the person already knows BotFather:
# spelled-out taps, a suggested name, and one string to copy. Telegram has
# no email+password login and only BotFather mints bots, so a token IS the
# minimal honest secret -- Sherman never asks for anyone's Telegram account
# login. WhatsApp is named as not built because silence would read as
# "does not exist". Reads $user for the suggested bot name; sets $tg_token.
ask_telegram() {
    tg_token=""
    bot_slug=$(printf '%s' "${user:-sherman}" | tr '-' '_')
    echo
    echo "Use Sherman from your phone via Telegram (optional -- Enter skips):"
    echo
    echo "  1. Open Telegram and go to:  https://t.me/BotFather"
    echo "  2. Send:      /newbot"
    echo "  3. Name it:   ${user:-your name}'s Sherman"
    echo "  4. Username:  ${bot_slug}_sherman_bot     (Telegram requires the 'bot' ending)"
    echo "  5. BotFather replies with a token -- copy it and paste it here."
    echo
    echo "That token is the only secret involved. Sherman never asks for your"
    echo "Telegram account login -- no email, no password, no phone number."
    echo "(WhatsApp is not built yet; Telegram is the phone channel today.)"
    printf 'Telegram bot token > '
    read -r tg_token || tg_token=""
    tg_token=$(printf '%s' "$tg_token" | tr -d ' "')
    if [ -n "$tg_token" ]; then
        echo "  After setup, run: sherman telegram -- it shows a pairing code;"
        echo "  text that code to your bot and the chat pairs itself."
    fi
}

# One-time catch-up for a machine set up before newer questions existed:
# config versions below 2 get asked exactly the questions they never saw,
# then the version is bumped so this never repeats. Interactive terminals
# only -- a piped or scripted run is not a person who can answer.
run_setup_upgrade() {
    echo
    echo "Sherman has new setup options this machine has not answered yet."
    engine="$ENGINE"
    user="$USER_SLUG"
    ask_model
    ask_telegram
    if [ -n "$tg_token" ]; then
        config_set telegram_token "$tg_token"
        echo "  telegram: token saved -- run: sherman telegram"
        echo "            (first message to the bot prints the chat id to pair)"
    fi
    if command -v /usr/bin/jq >/dev/null 2>&1; then
        /usr/bin/jq '.version = 2' "$CONFIG" > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"
    else
        sed -i.bak 's/"version"[[:space:]]*:[[:space:]]*[0-9][0-9]*/"version":2/' "$CONFIG" && rm -f "$CONFIG.bak"
    fi
    echo
}

# ------------------------------------------------------------ config access --
config_get() {
    if command -v /usr/bin/jq >/dev/null 2>&1; then
        /usr/bin/jq -r --arg k "$1" '.[$k] // empty' "$CONFIG"
    else
        # Fallback for a machine without jq. Values here are engine names,
        # slugs and paths -- no embedded quotes to worry about.
        sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$CONFIG"
    fi
}

# Set one string key in the config, verified by reading it back. The config is
# this script's own single-line JSON, which is what keeps the no-jq fallback
# honest: it edits a shape this script wrote.
config_set() {
    if [ ! -f "$CONFIG" ]; then
        echo "No config yet. Run sherman once to set up this machine, then retry." >&2
        exit 1
    fi
    if command -v /usr/bin/jq >/dev/null 2>&1; then
        /usr/bin/jq --arg k "$1" --arg v "$2" '.[$k] = $v' "$CONFIG" > "$CONFIG.tmp" \
            && mv "$CONFIG.tmp" "$CONFIG"
    else
        if grep -q "\"$1\"" "$CONFIG"; then
            sed -i.bak "s/\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"$1\":\"$2\"/" "$CONFIG" && rm -f "$CONFIG.bak"
        else
            sed -i.bak "s/}\$/,\"$1\":\"$2\"}/" "$CONFIG" && rm -f "$CONFIG.bak"
        fi
    fi
    if [ "$(config_get "$1")" != "$2" ]; then
        echo "Could not write $1 to $CONFIG." >&2
        exit 1
    fi
}

# ------------------------------------------------------------------- update --
shell_version() {
    # package.json's formatting is machine-stable; sed keeps this path working
    # on a machine with no jq at all.
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$ROOT/shell/package.json" 2>/dev/null | head -1
}

# `sherman update` pulls this checkout forward, and says so honestly when it
# cannot: no remote means no update source, and a diverged tree is a person's
# merge to make, never this script's. It must work with no engine installed
# and no config written, which is why it dispatches before everything else.
run_update() {
    if ! command -v git >/dev/null 2>&1 \
        || ! git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
        echo "This install is not a git checkout, so it cannot self-update."
        echo "Updates come from the installer: $ROOT/install.sh"
        exit 0
    fi

    if [ -z "$(git -C "$ROOT" remote 2>/dev/null)" ]; then
        echo "Sherman Abrams v$(shell_version) — no update source configured."
        exit 0
    fi

    old_version=$(shell_version)
    old_head=$(git -C "$ROOT" rev-parse HEAD)

    if ! git -C "$ROOT" pull --ff-only; then
        echo >&2
        echo "manual update needed — this checkout cannot fast-forward onto its remote." >&2
        exit 1
    fi

    # npm only when the pull actually changed the shell's manifest; anything
    # else would re-resolve dependencies on every no-op update.
    if ! git -C "$ROOT" diff --quiet "$old_head" HEAD -- shell/package.json; then
        npm install --prefix "$ROOT/shell"
    fi

    # smoke calls `sherman update`, and update runs smoke after a real pull.
    # The env guard is what keeps that pair from recursing forever.
    SHERMAN_UPDATE_RUNNING=1 "$ROOT/smoke.sh"

    echo "Updated: v$old_version -> v$(shell_version)"
    exit 0
}

# --------------------------------------------------------------------- sync --
# `sherman sync` makes the vault the SAME vault on every machine, through the
# repo itself: pull what other machines published, publish what this one
# learned. Only the shared lanes travel -- wiki, shared memory, inbox.
# Private memory is gitignored and stays on this machine by design; this
# function's explicit path list is the second fence. It never touches code,
# and it refuses to run over someone else's staged work.
run_sync() {
    if ! command -v git >/dev/null 2>&1 \
        || ! git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
        echo "This install is not a git checkout, so the vault cannot sync."
        exit 1
    fi
    if [ -z "$(git -C "$ROOT" remote 2>/dev/null)" ]; then
        echo "No remote configured -- there is no shared vault to sync with."
        exit 1
    fi

    if ! git -C "$ROOT" diff --cached --quiet 2>/dev/null; then
        echo "Something is already staged in this checkout -- likely another"
        echo "session's work. Sync refuses to commit over it. Resolve that"
        echo "staging first, then run sherman sync again."
        exit 1
    fi

    if ! git -C "$ROOT" pull --ff-only; then
        echo >&2
        echo "manual merge needed -- this checkout cannot fast-forward onto its remote." >&2
        exit 1
    fi

    git -C "$ROOT" add -A -- vault/wiki vault/memory/shared vault/inbox 2>/dev/null

    if git -C "$ROOT" diff --cached --quiet; then
        echo "Vault is in sync: pulled the latest, nothing new to publish from here."
        exit 0
    fi

    who=""
    [ -f "$CONFIG" ] && who=$(config_get user)
    [ -n "$who" ] || who=$(whoami)
    git -C "$ROOT" commit -m "vault: sync from $who ($(date +%Y-%m-%d))" >/dev/null
    echo "Committed this machine's shared-vault changes."

    if git -C "$ROOT" push 2>/dev/null; then
        echo "Published (verified: git push succeeded). Every other machine"
        echo "gets this on its next sherman sync."
    else
        echo "Could not push -- this machine has no write access to the remote."
        echo "The commit is safe locally. Sign in to GitHub (for example:"
        echo "gh auth login), then run sherman sync again to publish."
        exit 1
    fi
    exit 0
}

# -------------------------------------------------------- adapter assembly --
# One body, generated here, spliced into whichever engine wrapper applies. The
# persona and the memory blocks exist in exactly one place each -- hand-copying
# them into two adapters is how the either-engine promise decays into
# Claude-only.
assemble_adapter() {
    engine="$1"; user="$2"; vault="$3"; session="$4"; sdate="$5"

    case "$engine" in
        claude) template="$ROOT/adapters/claude-code/CLAUDE.md"; out="$WORKSPACE/CLAUDE.md" ;;
        codex)  template="$ROOT/adapters/codex/AGENTS.md";        out="$WORKSPACE/AGENTS.md" ;;
        *)
            echo "Unknown engine in config: $engine" >&2
            exit 1
            ;;
    esac

    if [ ! -f "$template" ]; then
        echo "Adapter template missing: $template" >&2
        exit 1
    fi
    if [ ! -f "$ROOT/agent/SYSTEM.md" ]; then
        echo "Persona missing: $ROOT/agent/SYSTEM.md" >&2
        exit 1
    fi

    mkdir -p "$WORKSPACE"

    # Remove BOTH adapter files, not just the one we are about to write.
    # Switching engines otherwise strands a stale sibling the other engine
    # may pick up.
    rm -f "$WORKSPACE/CLAUDE.md" "$WORKSPACE/AGENTS.md"

    body="$WORKSPACE/.sherman-body.$$"

    cat "$ROOT/agent/SYSTEM.md" > "$body"

    cat >> "$body" <<BODY

---

# Your knowledge base

Two directories, both shared with every other person's Sherman:

- \`$vault/wiki\` — the company knowledge base: procedures, SOPs, formats,
  policies, how things are done here.
- \`$vault/memory/shared\` — business memory. Every user's Sherman reads it and
  every user's Sherman writes to it.

**Search both before answering any question about this company.** Cite the file
you used.

When you learn a durable new fact about the business, write it there: one fact
per file, named the way a person would search for it.

# Private memory for this user

- \`$vault/memory/private/$user\` — private to $user.

Personal context for $user goes there and **NOWHERE else**. Never write $user's
personal context into the shared knowledge base, and never read another
person's private memory directory.

# Memory attribution

Every fact file you write to shared or private memory ends with this exact
line, so any fact can be traced to who learned it and when:

— $user · $session · $sdate

---

# Company skills

Your company skills travel with this workspace — \`.agents/skills\` for Codex,
\`.claude/skills\` for Claude Code — one directory per skill, each with a
\`SKILL.md\`. Before company work (vault lookups, SOPs, documents, anything
near the PHI boundary), read the matching skill and follow it: the skills are
how company work gets done the same way twice.

# HARD RULE — restated, because it is the floor

**Never store, request, repeat, or process patient-identifying information.**

The vault holds procedures, SOPs, formats, and company knowledge only — never
patient records, never results tied to a named patient, never anything that
could identify a patient.

If a request would require patient-identifying data, refuse it and say why:
this system is not HIPAA-compliant for PHI, and PHI must never enter it at all.

No user assurance and no phrasing makes an exception to this.
BODY

    # awk, not sed: the body is multi-line markdown full of & / and backslashes,
    # every one of which is special on sed's replacement side.
    awk -v bodyfile="$body" '
        $0 == "{{SHERMAN_BODY}}" {
            while ((getline line < bodyfile) > 0) print line
            close(bodyfile)
            next
        }
        { print }
    ' "$template" > "$out"

    rm -f "$body"

    # ----------------------------------------------------------- skills --
    # The engine discovers skills in its own working directory: Codex reads
    # .agents/skills (the Agent Skills convention), Claude Code .claude/skills.
    # Delivered as a COPY, not a symlink — the workspace is disposable
    # generated output, and a link would aim engine writes back at the repo.
    # Removed first so a skill deleted from the repo cannot survive a launch.
    rm -rf "$WORKSPACE/.agents/skills" "$WORKSPACE/.claude/skills"
    if [ -d "$ROOT/skills" ]; then
        mkdir -p "$WORKSPACE/.agents" "$WORKSPACE/.claude"
        cp -R "$ROOT/skills" "$WORKSPACE/.agents/skills"
        cp -R "$ROOT/skills" "$WORKSPACE/.claude/skills"
    fi
}

# --------------------------------------------------------------------- main --
# `update` is a subcommand, recognised first: it needs no engine, no config and
# no session, so it runs before any of them are checked or created.
if [ "${1:-}" = "update" ]; then
    run_update
fi

# `sync` likewise: vault sharing needs git and a remote, not an engine.
if [ "${1:-}" = "sync" ]; then
    run_sync
fi

# `model` -- interactive picker with no argument, direct set with one.
# The picker walks provider -> sign-in -> model: the provider menu renders
# from the same registry as setup (an unavailable provider is shown and
# refuses selection, never sold), the sign-in check is codex's own
# `codex login status`, and the model menu lists the models this shell
# knows context windows for -- read live from shell/src/config.js, so one
# map feeds both -- stated as "known here", because codex 0.145 offers no
# way to enumerate models and this menu does not pretend otherwise.
run_model_picker() {
    echo
    echo "Provider:"
    total=$(provider_count)
    i=1
    while [ "$i" -le "$total" ]; do
        if [ "$(provider_field "$i" 4)" = "available" ]; then
            echo "  [$i] $(provider_field "$i" 2)"
        else
            echo "  [$i] $(provider_field "$i" 2) — not available yet"
        fi
        i=$((i + 1))
    done
    picked=""
    while [ -z "$picked" ]; do
        printf 'Choose a number > '
        if ! read -r reply; then echo; exit 1; fi
        case "$reply" in ''|*[!0-9]*) echo "  Enter a number between 1 and $total."; continue ;; esac
        if [ "$reply" -lt 1 ] || [ "$reply" -gt "$total" ]; then
            echo "  Enter a number between 1 and $total."; continue
        fi
        if [ "$(provider_field "$reply" 4)" != "available" ]; then
            echo "  $(provider_field "$reply" 2) is not available yet — $(provider_field "$reply" 5)."
            continue
        fi
        picked=$(provider_field "$reply" 1)
    done

    ensure_linux_codex || exit 1
    if ! command -v codex >/dev/null 2>&1; then
        engine_install_hint codex
        exit 1
    fi
    if codex login status >/dev/null 2>&1; then
        echo "  signed in ($(codex login status 2>/dev/null | head -1))"
    else
        printf 'Not signed in. Run codex login now (opens a browser)? [y/N] > '
        read -r yn || yn=""
        case "$yn" in
            y|Y|yes|YES)
                codex login || { echo "  login did not complete; try again later."; exit 1; }
                ;;
            *)
                echo "  staying signed out -- codex will run its login on first use."
                ;;
        esac
    fi

    current=$(read_codex_model)
    echo
    if [ -n "$current" ]; then
        echo "Model [current: $current] -- the models this shell knows"
    else
        echo "Model [current: codex default] -- the models this shell knows"
    fi
    echo "(codex accepts others too; type a name instead of a number):"
    known_models=$(sed -n "/MODEL_CONTEXT_WINDOWS/,/})/s/^[[:space:]]*'\([^']*\)':.*/\1/p" "$ROOT/shell/src/config.js")
    i=1
    for m in $known_models; do
        echo "  [$i] $m"
        i=$((i + 1))
    done
    count=$((i - 1))
    printf 'Choose a number, type a model name, or Enter to keep as is > '
    read -r choice || choice=""
    choice=$(printf '%s' "$choice" | tr -d '" ')
    [ -z "$choice" ] && { echo "  keeping it as is."; exit 0; }
    case "$choice" in
        *[!0-9]*)
            write_codex_model "$choice"; exit $? ;;
        *)
            if [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
                sel=$(printf '%s\n' $known_models | sed -n "${choice}p")
                write_codex_model "$sel"; exit $?
            fi
            echo "  Enter 1-$count, a model name, or nothing."
            exit 1 ;;
    esac
}

if [ "${1:-}" = "model" ]; then
    shift
    if [ -z "${1:-}" ]; then
        if [ -t 0 ]; then
            run_model_picker
        fi
        current=$(read_codex_model)
        if [ -n "$current" ]; then
            echo "model: $current (from $(codex_config_path))"
        else
            echo "model: codex default (no top-level model in $(codex_config_path))"
        fi
        echo "change it with: sherman model <name>   (e.g. sherman model gpt-5.6-sol)"
        exit 0
    fi
    if write_codex_model "$1"; then exit 0; else exit 1; fi
fi

# `telegram` runs the messaging bridge over the same assembled adapter the
# shell uses -- same persona, same no-PHI contract, same engine session
# layer. --token saves the bot token; pairing normally happens by texting
# the code the bridge shows (--allow remains the manual override). The
# bare form falls through the normal launch path (wizard if unconfigured,
# engine check, adapter assembly) and then execs the bridge instead of the
# shell. DESIGN.md's rule is honored, not dodged: the connect flow exists
# because the bridge now does.
TELEGRAM=0
if [ "${1:-}" = "telegram" ]; then
    shift
    case "${1:-}" in
        --token)
            if [ -z "${2:-}" ]; then
                echo "Usage: sherman telegram --token <bot-token>   (from @BotFather)" >&2
                exit 1
            fi
            config_set telegram_token "$2"
            echo "token saved (verified: read back from config). Next: sherman telegram"
            exit 0
            ;;
        --allow)
            if [ -z "${2:-}" ]; then
                echo "Usage: sherman telegram --allow <chat-id>" >&2
                exit 1
            fi
            config_set telegram_chat "$2"
            echo "chat $2 paired (verified: read back from config). Restart sherman telegram."
            exit 0
            ;;
    esac
    TELEGRAM=1
fi

# --raw is recognised as the FIRST argument only, and stripped before the engine
# sees the rest. Everything else passes straight through, unchanged.
RAW=0
if [ "${1:-}" = "--raw" ]; then
    RAW=1
    shift
fi

# In raw mode nothing downstream draws our brand, so the launcher does it. In
# shell mode the shell owns the screen and renders the mark itself -- doing it
# here as well would print the banner twice on every launch.
if [ "$RAW" -eq 1 ]; then
    launch_screen
fi

if [ ! -f "$CONFIG" ]; then
    [ "$RAW" -eq 1 ] || wizard_header
    run_wizard
fi

ENGINE=$(config_get engine)
USER_SLUG=$(config_get user)
VAULT=$(config_get vault_path)

if [ -z "$ENGINE" ] || [ -z "$USER_SLUG" ] || [ -z "$VAULT" ]; then
    echo "Config at $CONFIG is incomplete. Delete it and run sherman again." >&2
    exit 1
fi

# A config from before the newer setup questions gets them asked once, now,
# rather than silently never -- "it didn't ask me" is a bug report this
# launcher takes seriously. Non-interactive runs skip; they cannot answer.
cfg_version=$(config_get version)
case "$cfg_version" in
    ''|0|1)
        if [ -t 0 ]; then
            run_setup_upgrade
        fi
        ;;
esac

require_engine "$ENGINE"

# One id per launch, minted HERE so the same id reaches all three places it was
# promised: the adapter's attribution rule (assembled below), both handoffs
# (via the environment), and the shell's launch panel and session log. Per-launch
# state only -- it is never written to config.json.
SESSION_ID="$(date +%Y%m%d_%H%M%S)_$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
SESSION_DATE="$(date +%Y-%m-%d)"
export SHERMAN_SESSION_ID="$SESSION_ID"

# Idempotent: keeps adapter paths resolvable even if the vault moved or was
# cleared. Directories only -- the vault's contents are not this script's job.
mkdir -p "$VAULT/wiki" "$VAULT/memory/shared" "$VAULT/memory/private/$USER_SLUG"

assemble_adapter "$ENGINE" "$USER_SLUG" "$VAULT" "$SESSION_ID" "$SESSION_DATE"

# Either handoff runs from the workspace, so the engine's cwd is identical in
# both modes -- that is what makes it pick up the adapter we just assembled.
cd "$WORKSPACE"

if [ "$RAW" -eq 1 ]; then
    exec "$(engine_binary "$ENGINE")" "$@"
fi

require_node

if [ "$TELEGRAM" -eq 1 ]; then
    exec node "$ROOT/bridge/telegram.js"
fi

exec node "$ROOT/shell/bin/sherman-shell.js" "$@"
